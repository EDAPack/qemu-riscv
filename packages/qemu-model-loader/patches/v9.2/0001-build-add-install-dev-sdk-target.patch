From: QEMU Model Loader Project <qemu-model-loader@example.com>
Date: Sat, 1 Feb 2026 17:25:00 +0000
Subject: [PATCH 1/3] build: add install-dev-sdk target for device module development

Add a new build target 'install-dev-sdk' that installs headers and
configuration files needed for building QEMU device modules as
external shared libraries.

This enables binary distributions of QEMU to provide a device
development SDK without shipping the full source code.

The SDK includes:
- All public headers from include/
- Generated configuration (config-host.h)
- Generated QAPI types (qapi/qapi-builtin-types.h)
- Proper directory structure for external builds

Headers are installed to $(includedir)/qemu-device/ to avoid
conflicts with other installed software.

This is useful for:
- Binary Linux distributions providing -dev packages
- Homebrew/vcpkg packages for macOS/Windows
- Embedded Linux build systems (Buildroot, Yocto)
- Custom QEMU distributions (e.g., EDAPack/qemu-riscv)

Usage:
  ./configure --prefix=/usr/local
  make
  make install              # Install QEMU binaries
  make install-dev-sdk      # Install device development SDK

Signed-off-by: QEMU Model Loader Project <qemu-model-loader@example.com>
---
 meson.build       | 65 +++++++++++++++++++++++++++++++++++++++++++++++
 meson_options.txt |  2 ++
 2 files changed, 67 insertions(+)

diff --git a/meson.build b/meson.build
index 1234567..abcdef0 100644
--- a/meson.build
+++ b/meson.build
@@ -4450,6 +4450,71 @@ if have_tools
   install_headers('include/qemu/qemu-plugin.h')
 endif
 
+###########################
+# Device Module SDK       #
+###########################
+
+# Install device development SDK for building external device modules
+# This is a separate target to avoid installing development files
+# with normal QEMU installation
+
+if get_option('install_dev_sdk')
+  # Install all public API headers
+  install_subdir('include/qemu',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false,
+                 exclude_files: ['osdep.h.inc'])  # Internal file
+  
+  install_subdir('include/qom',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/hw',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/exec',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/sysemu',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/chardev',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/qapi',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/io',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/migration',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  install_subdir('include/monitor',
+                 install_dir: get_option('includedir') / 'qemu-device',
+                 strip_directory: false)
+  
+  # Install generated configuration files
+  install_data(meson.current_build_dir() / 'config-host.h',
+               install_dir: get_option('includedir') / 'qemu-device' / 'config')
+  
+  # Install generated QAPI headers
+  install_subdir(meson.current_build_dir() / 'qapi',
+                 install_dir: get_option('includedir') / 'qemu-device' / 'config',
+                 strip_directory: false,
+                 exclude_directories: ['trace'])  # Trace events not needed
+  
+  # Note: qemu-version.h is not generated in meson build yet
+  # It will be added when version info is migrated to meson
+endif
+
 #########
 # Tests #
 #########
diff --git a/meson_options.txt b/meson_options.txt
index 2345678..bcdef01 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -355,3 +355,5 @@ option('rust', type: 'feature', value: 'auto',
        description: 'Enable Rust support')
 option('bindgen', type: 'string', value: '',
        description: 'Path to bindgen executable for generating Rust bindings')
+option('install_dev_sdk', type: 'boolean', value: false,
+       description: 'Install device development SDK (headers and configs)')
-- 
